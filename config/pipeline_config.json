  "tiers": {
    "tier_1_research_agent": {
      "role": "Research Agent (研究员)",
      "mission": "自主调研、检索事实、构建证据链、进行产业拓扑与财务估值建模，输出初版研报与结构化机器数据底盘",
      "model_provider": "default",
      "model_name": "claude-3-7-sonnet",
      "temperature": 0.2,
      "internal_qa": {
        "enabled": true,
        "mode": "self_consistency_check",
        "description": "研究员内部在提交交付物前的初步完整性自检"
      },
      "deliverables": [
        "report.md",
        "evidence.jsonl",
        "assumptions.json",
        "thesis.json",
        "monitor.json"
      ]
    },
    "tier_2_evidence_auditor": {
      "role": "Evidence Auditor (独立审稿人)",
      "mission": "不信任研究员给出的结论与二手转述，独立提取并重新查验原始来源，定位证据跨度，核验蕴含关系，重算关键数学公式与参数正交性",
      "model_config": {
        "use_same_model_as_researcher": true,
        "default_model": "inherit",
        "custom_override": {
          "enabled": true,
          "provider": "ollama",
          "model_name": "qwen2.5-benchmark",
          "api_base": "http://127.0.0.1:22434/v1",
          "api_key": "ollama",
          "temperature": 0.0,
          "timeout_seconds": 90,
          "max_review_chars": 24000,
          "comment": "Tier 2 独立审稿人。默认接本地 Ollama (qwen2.5-benchmark, 127.0.0.1:22434)，该模型实测三轮 JSON 全稳且证据引用校验通过。max_review_chars 截断超长网页送审(快照仍绑全文哈希)；本机 Ollama 上下文约32k字符，>24k 留余量。云模型则 api_key 必须为 env:VAR_NAME，禁止明文。"
        }
      },
      "independent_verification_pipeline": {
        "independent_refetch": true,
        "source_existence_check": true,
        "claim_entailment_eval": true,
        "target_to_result_drift_intercept": true,
        "epistemic_birth_certificate_audit": true,
        "parameter_recomputability_check": true,
        "mechanism_orthogonality_audit": true,
        "causal_distance_penalty_audit": true,
        "valuation_decoupling_audit": true
      }
