# ---- agent-rag 根目录忽略规则 ----
# 原则：秘密令牌/密钥只允许通过环境变量注入，绝不允许以任何形式入库（文件或 .env）

# Python 缓存与构建
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 密钥与环境变量（一律不入库）
.env
.env.*
!.env.example
config/*.secret.json
config/*.secret.json.*
*.key
*.pem
token.txt
secrets/

# 本地运行时产物（抓取快照、临时凭证、本地服务数据）
reports/*/source_snapshots/
tmp/
temp/

# 原始语料（1.8GB 课程资料，含版权风险；RAG 索引才是入库的知识资产）
inputDoc/
holdout/

# 临时基准/分析草稿（正式基准报告保留）
reports/_scratch/
reports/analysis/*.md

# 备份文件
*_backup_*.json
_pre_batch_backup.json

# 编辑器/系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 用户的本地个人凭据目录（若被复制进项目，忽略之）
.agent-rag-secrets/